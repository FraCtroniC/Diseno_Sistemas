# Servidor
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Base de datos
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require
DB_SSL=true
DB_LOGGING=false

# Seguridad
JWT_SECRET=your_jwt_secret_here
TRUST_PROXY_HOPS=1
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=5
AUTH_GENERAL_RATE_LIMIT_MAX=20
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=65000
SOCKET_TIMEOUT_MS=120000

# Almacenamiento de PDFs: cloudinary (producción) o local (pruebas)
CLOUDINARY_MODE=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
LOCAL_UPLOAD_DIR=

# Correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@repositorio.unefa.edu.ve
